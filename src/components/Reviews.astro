---
// src/components/Reviews.astro
import { reviews } from '../data/reviews';
---

<section class="py-24 px-4 md:px-20 max-w-7xl mx-auto" id="resenas">
  <div class="text-center mb-16" data-aos="fade-up">
    <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 px-4 py-1.5 rounded-full text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
      <span>⭐ Calificación 4.9 de 5.0 en Google & TripAdvisor</span>
    </div>
    <h2 class="text-4xl md:text-5xl text-white font-bold mb-4">Lo que dicen nuestros visitantes</h2>
    <p class="text-slate-400 text-lg max-w-xl mx-auto font-light">Experiencias reales de quienes han vivido la magia en el Cerro del Monumento.</p>
  </div>

  <div class="grid md:grid-cols-3 gap-8" data-aos="fade-up" data-aos-delay="200">
    {reviews.map((rev) => (
      <div class="bg-slate-900/80 p-8 rounded-3xl border border-slate-800 relative flex flex-col justify-between hover:border-amber-500/40 transition duration-300">
        <div>
          <div class="flex text-amber-400 text-lg mb-4">
            {"★".repeat(rev.rating)}
          </div>
          <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">"{rev.comment}"</p>
        </div>
        <div class="flex items-center gap-3 border-t border-slate-800 pt-4">
          <div class={`w-10 h-10 rounded-full bg-gradient-to-tr ${rev.avatarBg} flex items-center justify-center font-bold text-white text-sm`}>
            {rev.initials}
          </div>
          <div>
            <h4 class="text-white font-bold text-sm">{rev.name}</h4>
            <span class="text-slate-500 text-xs">{rev.role}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

