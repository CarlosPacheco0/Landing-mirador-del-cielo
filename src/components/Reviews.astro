---
// src/components/Reviews.astro
import { reviews } from '../data/reviews';
---

<section class="py-24 px-4 md:px-20 max-w-7xl mx-auto" id="resenas">
  <div class="text-center mb-16" data-aos="fade-up">
    <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 px-4 py-1.5 rounded-full text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
      <span>⭐ Calificación 4.9 de 5.0 en Google & TripAdvisor</span>
    </div>
    <h2 class="text-4xl md:text-5xl text-white font-bold mb-4">Lo que dicen nuestros visitantes</h2>
    <p class="text-slate-400 text-lg max-w-xl mx-auto font-light">Experiencias reales de quienes han vivido la magia en el Cerro del Monumento.</p>
  </div>

  <div class="grid md:grid-cols-3 gap-8" data-aos="fade-up" data-aos-delay="200">
    {reviews.map((rev) => (
      <div class="bg-slate-900/80 p-8 rounded-3xl border border-slate-800 relative flex flex-col justify-between hover:border-amber-500/40 transition duration-300">
        <div>
          <div class="flex text-amber-400 text-lg mb-4">
            {"★".repeat(rev.rating)}
          </div>
          <p class="text-slate-300 text-sm leading-relaxed mb-6 font-light">"{rev.comment}"</p>
        </div>
        <div class="flex items-center gap-3 border-t border-slate-800 pt-4">
          <div class={`w-10 h-10 rounded-full bg-gradient-to-tr ${rev.avatarBg} flex items-center justify-center font-bold text-white text-sm`}>
            {rev.initials}
          </div>
          <div>
            <h4 class="text-white font-bold text-sm">{rev.name}</h4>
            <span class="text-slate-500 text-xs">{rev.role}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- TARJETA CTA: DEJAR RESEÑA POR WHATSAPP O GOOGLE MAPS -->
  <div class="mt-12 bg-gradient-to-b sm:bg-gradient-to-r from-slate-900/90 via-[#111726] to-slate-900/90 border border-amber-500/30 rounded-3xl p-8 sm:p-10 text-center max-w-3xl mx-auto shadow-2xl relative overflow-hidden" data-aos="zoom-in" data-aos-delay="300">
    <div class="absolute -top-10 -right-10 w-40 h-40 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>
    <div class="relative z-10">
      <div class="inline-flex items-center gap-1.5 text-amber-400 text-sm mb-3">
        <span>⭐</span><span>⭐</span><span>⭐</span><span>⭐</span><span>⭐</span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-bold text-white font-serif mb-3">
        ¿Nos visitaste recientemente?
      </h3>
      <p class="text-slate-300 text-sm sm:text-base font-light max-w-xl mx-auto mb-6 leading-relaxed">
        Tu testimonio nos ayuda a seguir mejorando y a compartir la magia de Río de Oro con más viajeros. Envíanos tu reseña por WhatsApp y la destacaremos en nuestra web.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-4">
        <button 
          onclick="openReviewModal()" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-bold py-3.5 px-8 rounded-full text-xs uppercase tracking-wider transition-all duration-300 shadow-lg shadow-amber-500/25 hover:scale-105 cursor-pointer"
        >
          <span>✍️</span>
          <span>Calificar mi Experiencia</span>
        </button>
        <a 
          href="https://maps.google.com/maps?q=Cerro%20de%20la%20virgen%20del%20rosario%20rio%20de%20oro" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 text-slate-200 font-bold py-3.5 px-7 rounded-full text-xs uppercase tracking-wider transition duration-300"
        >
          <span>📍</span>
          <span>Opinar en Google Maps</span>
        </a>
      </div>
    </div>
  </div>
</section>

