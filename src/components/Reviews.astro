---
// src/components/Reviews.astro
import { siteConfig } from '../data/site';

const googleMapsPlaceUrl = siteConfig.googleMaps.placeUrl;
const googleMapsReviewUrl = siteConfig.googleMaps.reviewUrl;

const starDistribution = [
  { stars: 5, percent: 100 },
  { stars: 4, percent: 0 },
  { stars: 3, percent: 0 },
  { stars: 2, percent: 0 },
  { stars: 1, percent: 0 }
];
---

<section class="py-24 px-4 md:px-20 max-w-7xl mx-auto" id="resenas">
  <div class="text-center mb-12" data-aos="fade-up">
    <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 px-4 py-1.5 rounded-full text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
      <span>⭐ Calificación {siteConfig.rating.ratingValue} de {siteConfig.rating.bestRating}.0 en Google Maps</span>
    </div>
    <h2 class="text-4xl md:text-5xl text-white font-bold mb-4">Calificación y Experiencias</h2>
    <p class="text-slate-400 text-lg max-w-xl mx-auto font-light">Valoración oficial de nuestra ficha en Google Maps y espacio abierto para tus opiniones en el Cerro de la Virgen.</p>
  </div>

  <!-- RESUMEN REAL DE GOOGLE MAPS -->
  <div class="max-w-3xl mx-auto bg-slate-900/80 border border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl mb-8" data-aos="fade-up" data-aos-delay="150">
    <div class="grid sm:grid-cols-12 gap-6 items-center">
      <div class="sm:col-span-5 text-center sm:text-left sm:border-r sm:border-slate-800 sm:pr-6">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400 block mb-1">Google Maps</span>
        <div class="flex items-baseline justify-center sm:justify-start gap-2">
          <span class="text-5xl font-black text-white font-serif">{siteConfig.rating.ratingValue}</span>
          <span class="text-slate-400 text-sm">/ {siteConfig.rating.bestRating}.0</span>
        </div>
        <div class="text-amber-400 text-xl tracking-wider my-1.5" aria-label="5 de 5 estrellas">★★★★★</div>
        <p class="text-slate-300 text-xs font-medium">{siteConfig.rating.ratingCount} calificación registrada</p>
        <a
          href={googleMapsPlaceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-amber-400 hover:text-amber-300 text-xs font-semibold mt-3 transition-colors"
        >
          <span>Ver ficha en Google Maps</span>
          <span>↗</span>
        </a>
      </div>

      <div class="sm:col-span-7 space-y-2">
        {starDistribution.map((row) => (
          <div class="flex items-center gap-3 text-xs">
            <span class="w-6 text-slate-400 font-semibold text-right">{row.stars}★</span>
            <div class="flex-1 h-2 bg-slate-800 rounded-full overflow-hidden">
              <div
                class="h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full"
                style={`width: ${row.percent}%`}
              ></div>
            </div>
          </div>
        ))}
        <p class="text-slate-400 text-xs font-light pt-3 leading-relaxed">
          Aún no hay comentarios escritos publicados en nuestra ficha de Google Maps. ¡Tu opinión puede ser de las primeras en aparecer destacada aquí!
        </p>
      </div>
    </div>
  </div>

  <!-- TARJETA CTA: DEJAR RESEÑA POR WHATSAPP O GOOGLE MAPS -->
  <div class="bg-gradient-to-b sm:bg-gradient-to-r from-slate-900/90 via-[#111726] to-slate-900/90 border border-amber-500/30 rounded-3xl p-8 sm:p-10 text-center max-w-3xl mx-auto shadow-2xl relative overflow-hidden" data-aos="zoom-in" data-aos-delay="250">
    <div class="absolute -top-10 -right-10 w-40 h-40 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>
    <div class="relative z-10">
      <div class="inline-flex items-center gap-1.5 text-amber-400 text-sm mb-3">
        <span>⭐</span><span>⭐</span><span>⭐</span><span>⭐</span><span>⭐</span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-bold text-white font-serif mb-3">
        ¿Nos visitaste recientemente?
      </h3>
      <p class="text-slate-300 text-sm sm:text-base font-light max-w-xl mx-auto mb-6 leading-relaxed">
        Tu testimonio nos ayuda a seguir creciendo y a compartir la magia de Río de Oro con más viajeros. Déjanos tu reseña en Google Maps o envíanosla por WhatsApp para destacarla en nuestra web.
      </p>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-4">
        <button 
          onclick="openReviewModal()" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-bold py-3.5 px-8 rounded-full text-xs uppercase tracking-wider transition-all duration-300 shadow-lg shadow-amber-500/25 hover:scale-105 cursor-pointer"
        >
          <span>✍️</span>
          <span>Calificar mi Experiencia</span>
        </button>
        <a 
          href={googleMapsReviewUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 text-slate-200 font-bold py-3.5 px-7 rounded-full text-xs uppercase tracking-wider transition duration-300"
        >
          <span>📍</span>
          <span>Opinar en Google Maps</span>
        </a>
      </div>
    </div>
  </div>
</section>

