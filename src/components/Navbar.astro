---
// src/components/Navbar.astro
import { url } from '../utils/paths';
---

<nav class="fixed top-0 left-0 w-full z-50 bg-[#0B0F17]/90 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300" id="navbar">
  <div class="max-w-7xl mx-auto px-3 sm:px-4 md:px-8 h-20 flex items-center justify-between gap-2">
    
    <!-- Brand Logo -->
    <a href="#inicio" data-brand-loader class="flex items-center gap-2 sm:gap-3 group min-w-0">
      <img
        src={url('/images/logo-emblema.webp')}
        alt="Logo El Mirador del Cielo"
        width="32"
        height="48"
        class="h-10 sm:h-12 w-auto object-contain shrink-0 drop-shadow-[0_0_12px_rgba(245,158,11,0.35)] group-hover:scale-105 transition-transform duration-300"
      />
      <span class="text-[13.5px] min-[375px]:text-[15px] sm:text-xl font-extrabold text-white font-serif tracking-tight leading-tight truncate">
        El Mirador <span class="text-gradient">del Cielo</span>
      </span>
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center space-x-7 text-sm font-medium text-slate-300">
      <a href="#inicio" class="nav-link hover:text-amber-400 transition-colors">Inicio</a>
      <a href="#conoce" class="nav-link hover:text-amber-400 transition-colors">Conoce</a>
      <a href="#menu" class="nav-link hover:text-amber-400 transition-colors">Menú</a>
      <a href="#galeria" class="nav-link hover:text-amber-400 transition-colors">Galería</a>
      <a href="#souvenirs" class="nav-link hover:text-amber-400 transition-colors">Recuerdos</a>
      <a href="#resenas" class="nav-link hover:text-amber-400 transition-colors">Reseñas</a>
      <a href="#faq" class="nav-link hover:text-amber-400 transition-colors">FAQ</a>
    </div>

    <!-- CTA Buttons & Mobile Toggle -->
    <div class="flex items-center gap-1.5 min-[375px]:gap-2 sm:gap-3 shrink-0">
      <!-- Reservation Modal Button -->
      <button onclick="openReservationModal()" class="bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-bold text-[10.5px] min-[375px]:text-[11px] sm:text-xs uppercase tracking-wider py-2 px-2.5 min-[375px]:px-3 sm:py-2.5 sm:px-5 rounded-full transition duration-300 shadow-[0_0_15px_rgba(245,158,11,0.3)] hover:scale-105 cursor-pointer whitespace-nowrap">
        <span aria-hidden="true">📅</span><span class="hidden min-[350px]:inline"> Reservar</span>
      </button>
      
      <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-white p-1.5 min-[375px]:p-2 rounded-xl border border-slate-800 bg-slate-900/60 focus:outline-none cursor-pointer shrink-0" aria-label="Abrir Menú">
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#0B0F17]/95 backdrop-blur-xl border-b border-slate-800 px-6 py-6 space-y-3">
    <!-- Acceso Directo Destacado a Carta Digital -->
    <a href={url('/menu')} class="flex items-center justify-between text-amber-300 hover:text-white font-bold py-2.5 px-4 bg-amber-500/10 border border-amber-500/30 rounded-2xl mb-1 shadow-sm">
      <span class="flex items-center gap-2.5">
        <span class="text-base">🍽️</span>
        <span class="text-sm">Carta Digital Completa</span>
      </span>
      <span class="text-xs bg-amber-500/20 text-amber-300 font-mono px-2 py-0.5 rounded-full font-bold">Ver →</span>
    </a>

    <a href="#inicio" onclick="closeMobileMenu()" class="mobile-link block text-slate-200 hover:text-amber-400 font-medium py-1.5">Inicio</a>
    <a href="#conoce" onclick="closeMobileMenu()" class="mobile-link block text-slate-200 hover:text-amber-400 font-medium py-1.5">Conoce</a>
    <a href="#menu" onclick="closeMobileMenu()" class="mobile-link block text-slate-200 hover:text-amber-400 font-medium py-1.5">Especialidades</a>
    <a href="#galeria" onclick="closeMobileMenu()" class="mobile-link block text-slate-200 hover:text-amber-400 font-medium py-1.5">Galería</a>
    <a href="#souvenirs" onclick="closeMobileMenu()" class="mobile-link block text-slate-200 hover:text-amber-400 font-medium py-1.5">Recuerdos</a>
    <a href="#resenas" onclick="closeMobileMenu()" class="mobile-link block text-slate-200 hover:text-amber-400 font-medium py-1.5">Reseñas</a>
    <a href="#faq" onclick="closeMobileMenu()" class="mobile-link block text-slate-200 hover:text-amber-400 font-medium py-1.5">FAQ</a>

    <div class="pt-3 flex flex-col gap-2.5">
      <button onclick="openReservationModal(); closeMobileMenu();" class="w-full text-center bg-gradient-to-r from-amber-500 to-orange-600 text-white font-bold py-3 rounded-full cursor-pointer shadow-lg shadow-amber-500/25">
        📅 Reservar Mesa
      </button>
      <a href="#contacto" onclick="closeMobileMenu()" class="mobile-link block w-full text-center border border-slate-700 hover:border-slate-500 text-slate-300 font-bold py-2.5 rounded-full">
        📍 Dónde Estamos & GPS
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function closeMobileMenu() {
    if (mobileMenu) {
      mobileMenu.classList.add('hidden');
      if (iconOpen) iconOpen.classList.remove('hidden');
      if (iconClose) iconClose.classList.add('hidden');
    }
  }

  if (mobileMenuBtn) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>

