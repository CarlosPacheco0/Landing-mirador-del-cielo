---
// src/components/SocialBanner.astro
import { siteConfig } from '../data/site';
---

<section class="py-16 px-4 md:px-20 bg-gradient-to-r from-amber-600/10 via-orange-600/15 to-amber-600/10 border-y border-amber-500/30 relative overflow-hidden" id="redes">
  <div class="max-w-5xl mx-auto text-center relative z-10" data-aos="zoom-in">
    <span class="bg-amber-500/20 border border-amber-500/40 text-amber-300 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider mb-4 inline-block">
      ¡Forma parte de nuestra comunidad!
    </span>
    <h3 class="text-4xl md:text-5xl font-bold text-white mb-4">Síguenos en Redes Sociales</h3>
    <p class="text-slate-300 text-lg mb-8 max-w-xl mx-auto font-light">Etiquétanos en tus mejores fotos y reels con <strong class="text-amber-400">{siteConfig.social.instagram.username}</strong> para repostearte.</p>
    
    <div class="flex flex-wrap justify-center gap-4">
      <a href={siteConfig.social.instagram.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-gradient-to-r from-purple-600 via-pink-600 to-amber-500 hover:opacity-95 text-white font-bold py-3.5 px-8 rounded-full transition duration-300 shadow-lg transform hover:scale-105">
        <svg class="w-6 h-6 mr-2" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        {siteConfig.social.instagram.username}
      </a>
    </div>
  </div>
</section>

