---
// src/components/Footer.astro
import { siteConfig } from '../data/site';
---

<footer class="py-24 px-4 md:px-20 bg-[#0B0F17] border-t border-slate-800/80" id="contacto">
  <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-16 items-start">
    
    <!-- Datos de Contacto -->
    <div data-aos="fade-up" data-aos-duration="1000">
      <h2 class="text-4xl md:text-5xl text-white font-bold mb-8">Planea tu visita</h2>
      <div class="space-y-6 mb-10">
        <div class="flex items-start">
          <span class="text-3xl mr-4">📍</span> 
          <div>
            <strong class="text-white block text-xl mb-1">Ubicación</strong> 
            <span class="text-slate-300">{siteConfig.location.address}, {siteConfig.location.locality} ({siteConfig.location.region})</span>
          </div>
        </div>
        <div class="flex items-start">
          <span class="text-3xl mr-4">🕒</span> 
          <div>
            <strong class="text-white block text-xl mb-1">Horarios de Atención</strong> 
            <span class="text-slate-300">{siteConfig.schedule.days}: {siteConfig.schedule.hours}</span><br />
            <span class="text-amber-400 font-medium text-xs uppercase tracking-wider">{siteConfig.schedule.goldenHourHint}</span>
          </div>
        </div>
        <div class="flex items-start">
          <span class="text-3xl mr-4">✨</span> 
          <div>
            <strong class="text-white block text-xl mb-1">Ambiente & Servicios</strong> 
            <span class="text-slate-300">Familiar, Pet Friendly, Terraza Abierta, Vista Panorámica</span>
          </div>
        </div>
      </div>
      
      <div class="flex flex-wrap gap-4">
        <a href={siteConfig.contact.getWhatsAppUrl("Hola! Deseo hacer una consulta para visitar El Mirador.")} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-[#25D366] hover:bg-green-500 text-white font-bold py-4 px-7 rounded-full transition duration-300 shadow-lg shadow-green-500/20 transform hover:scale-105">
          <svg class="w-6 h-6 mr-2.5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp Directo
        </a>
        <a href={siteConfig.googleMaps.directionsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-800 border border-amber-500/40 hover:border-amber-400 text-amber-300 hover:text-white font-bold py-4 px-7 rounded-full transition duration-300 shadow-lg shadow-black/40 transform hover:scale-105" title="Iniciar navegación paso a paso con Google Maps">
          <span>🧭</span>
          <span>Cómo Llegar (GPS)</span>
        </a>
        <button onclick="openReservationModal()" class="bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-bold py-4 px-7 rounded-full transition duration-300 shadow-lg shadow-amber-500/20 transform hover:scale-105 cursor-pointer">
          📅 Reservar Mesa
        </button>
      </div>
    </div>

    <!-- Mapa Interactivo -->
    <div data-aos="fade-up" data-aos-delay="200" data-aos-duration="1000" class="w-full h-full min-h-[350px] relative">
      <div class="absolute inset-0 bg-gradient-to-tr from-amber-500/20 to-orange-500/20 rounded-2xl blur-xl opacity-40"></div>
      <div class="relative w-full h-full rounded-2xl shadow-xl overflow-hidden border-2 border-slate-800 bg-slate-900">
        <iframe 
          src={siteConfig.googleMaps.embedUrl}
          width="100%" 
          height="100%" 
          style="border:0; min-height: 380px;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
    
  </div>
  
  <div class="mt-20 pt-8 border-t border-slate-800/80 text-center text-slate-500 font-medium text-sm flex flex-col sm:flex-row justify-between items-center gap-4 max-w-7xl mx-auto">
    <p>&copy; 2026 El Mirador del Cielo. Río de Oro, Cesar (Colombia).</p>
    <p class="text-xs text-slate-600">Experiencia Gastronómica & Turismo de Montaña</p>
  </div>
</footer>

