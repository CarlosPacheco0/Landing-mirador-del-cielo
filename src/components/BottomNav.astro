---
// src/components/BottomNav.astro
import { url } from '../utils/paths';
import { siteConfig } from '../data/site';

const pathname = Astro.url.pathname;
const isMenu = pathname.includes('/menu');
const isHome = !isMenu;
---

<!-- BARRA DE NAVEGACIÓN INFERIOR PARA DISPOSITIVOS MÓVILES (Estilo App Nativa) -->
<nav class="md:hidden fixed bottom-0 left-0 w-full z-40 bg-[#0B0F17]/95 backdrop-blur-xl border-t border-slate-800/90 shadow-[0_-8px_30px_rgba(0,0,0,0.7)] px-2 py-2 safe-bottom" id="mobile-bottom-nav">
  <div class="max-w-md mx-auto grid grid-cols-5 items-center text-center">
    
    <!-- 1. Inicio -->
    <a 
      href={url('/#inicio')} 
      class={`flex flex-col items-center justify-center py-1 transition-all duration-200 group ${isHome ? 'text-amber-400 font-extrabold' : 'text-slate-400 hover:text-white'}`}
      title="Inicio"
    >
      <span class="text-lg leading-none mb-1 transition-transform group-active:scale-125">🌄</span>
      <span class="text-[10px] tracking-tight">Inicio</span>
    </a>

    <!-- 2. Menú Digital -->
    <a 
      href={url('/menu')} 
      class={`flex flex-col items-center justify-center py-1 transition-all duration-200 group ${isMenu ? 'text-amber-400 font-extrabold' : 'text-slate-400 hover:text-white'}`}
      title="Ver Carta Gastronómica"
    >
      <span class="text-lg leading-none mb-1 transition-transform group-active:scale-125">🍽️</span>
      <span class="text-[10px] tracking-tight">Carta</span>
    </a>

    <!-- 3. Botón Central Destacado: Reservar Mesa -->
    <button 
      type="button"
      onclick="openReservationModal()" 
      class="relative flex flex-col items-center justify-center -mt-5 group cursor-pointer focus:outline-none"
      title="Reservar Mesa"
    >
      <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-amber-500 to-orange-600 flex items-center justify-center text-white text-xl shadow-[0_0_20px_rgba(245,158,11,0.5)] border-2 border-[#0B0F17] group-active:scale-95 transition-transform duration-200">
        <span>📅</span>
      </div>
      <span class="text-[10px] font-extrabold text-amber-300 mt-1">Reservar</span>
    </button>

    <!-- 4. Calificar / Reseñas -->
    <button 
      type="button"
      onclick="openReviewModal()" 
      class="flex flex-col items-center justify-center py-1 text-slate-400 hover:text-white transition-all duration-200 group cursor-pointer focus:outline-none"
      title="Calificar Visita"
    >
      <span class="text-lg leading-none mb-1 transition-transform group-active:scale-125">⭐</span>
      <span class="text-[10px] font-bold tracking-tight">Opinar</span>
    </button>

    <!-- 5. Dónde Estamos / Cómo Llegar (GPS) -->
    <a 
      href={siteConfig.googleMaps.directionsUrl} 
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center py-1 text-slate-400 hover:text-white transition-all duration-200 group"
      title="Cómo Llegar en GPS con Google Maps"
    >
      <span class="text-lg leading-none mb-1 transition-transform group-active:scale-125">🧭</span>
      <span class="text-[10px] font-bold tracking-tight">Llegar</span>
    </a>

  </div>
</nav>

<style>
  .safe-bottom {
    padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
  }

  /* Elevar botón flotante de WhatsApp en móviles para que no tape los accesos del menú */
  @media (max-width: 768px) {
    :global(.fixed.bottom-6.right-6) {
      bottom: 5.25rem !important;
      right: 1rem !important;
    }
  }
</style>
