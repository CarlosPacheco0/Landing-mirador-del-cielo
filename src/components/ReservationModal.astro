---
// src/components/ReservationModal.astro
---

<div id="reservation-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
  <div class="bg-[#0D121D] w-full max-w-lg rounded-3xl border border-slate-800 p-6 sm:p-8 relative shadow-2xl max-h-[90vh] overflow-y-auto">
    <button onclick="closeReservationModal()" class="absolute top-5 right-5 text-slate-400 hover:text-white text-xl p-2 rounded-full hover:bg-slate-800 cursor-pointer">✕</button>

    <div class="mb-6">
      <span class="text-amber-400 font-semibold text-xs tracking-widest uppercase block mb-1">Asegura tu Espacio</span>
      <h3 class="text-2xl sm:text-3xl font-bold text-white">Reservar Mesa</h3>
      <p class="text-slate-400 text-xs sm:text-sm font-light mt-1">Disfruta de la mejor vista con tu grupo sin contratiempos.</p>
    </div>

    <form onsubmit="sendReservationToWhatsApp(event)" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Nombre Completo</label>
        <input type="text" id="res-name" required placeholder="Ej: Laura Mendoza" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-amber-500" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Fecha</label>
          <input type="date" id="res-date" required class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Hora Estimada</label>
          <select id="res-time" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500">
            <option value="4:30 PM (Hora Dorada)">4:30 PM (Atardecer)</option>
            <option value="5:30 PM">5:30 PM</option>
            <option value="6:30 PM">6:30 PM</option>
            <option value="7:30 PM">7:30 PM</option>
            <option value="8:30 PM">8:30 PM</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Nº de Personas</label>
          <select id="res-guests" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500">
            <option value="2 personas">2 Personas (Pareja)</option>
            <option value="3-4 personas">3 - 4 Personas</option>
            <option value="5-8 personas">5 - 8 Personas</option>
            <option value="Grupo Grande (9+)">Grupo Grande (9+)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Ocasión Especial</label>
          <select id="res-occasion" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500">
            <option value="Casual / Atardecer">Visita Casual</option>
            <option value="Cumpleaños">Cumpleaños</option>
            <option value="Aniversario / Cita">Aniversario</option>
            <option value="Reunión Familiar">Reunión Familiar</option>
          </select>
        </div>
      </div>

      <button type="submit" class="w-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-bold py-4 rounded-xl text-center shadow-lg shadow-amber-500/20 transition duration-300 mt-2 text-sm cursor-pointer">
        📱 Confirmar Reserva por WhatsApp
      </button>
    </form>
  </div>
</div>

<script is:inline>
  function openReservationModal() {
    const dateInput = document.getElementById('res-date');
    if (dateInput && !dateInput.value) {
      const today = new Date().toISOString().split('T')[0];
      dateInput.value = today;
    }
    const modal = document.getElementById('reservation-modal');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeReservationModal() {
    const modal = document.getElementById('reservation-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  }

  function sendReservationToWhatsApp(e) {
    e.preventDefault();
    const name = document.getElementById('res-name').value.trim();
    const date = document.getElementById('res-date').value;
    const time = document.getElementById('res-time').value;
    const guests = document.getElementById('res-guests').value;
    const occasion = document.getElementById('res-occasion').value;

    let message = `*¡Hola El Mirador del Cielo!* 🌄\n\nDeseo realizar una solicitud de reserva de mesa:\n\n👤 *Nombre:* ${name}\n📅 *Fecha:* ${date}\n🕒 *Hora:* ${time}\n👥 *Personas:* ${guests}\n✨ *Ocasión:* ${occasion}\n\n¿Tienen disponibilidad disponible? Gracias.`;

    const encoded = encodeURIComponent(message);
    window.open(`https://wa.me/573000000000?text=${encoded}`, '_blank');
    closeReservationModal();
  }
</script>

