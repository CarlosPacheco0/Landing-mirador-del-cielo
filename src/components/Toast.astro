---
// src/components/Toast.astro
---

<div id="toast" class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 hidden bg-slate-900/95 text-white border border-amber-500/40 px-6 py-3 rounded-full shadow-2xl text-xs font-bold flex items-center gap-2 backdrop-blur-md animate-fade-in">
  <span class="text-amber-400 text-base">✨</span>
  <span id="toast-text">Producto agregado al pedido</span>
</div>

<script is:inline>
  function showToast(text) {
    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toast-text');
    if (toast && toastText) {
      toastText.innerText = text;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3000);
    }
  }
</script>

