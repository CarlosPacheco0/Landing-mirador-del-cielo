---
// src/components/CartModal.astro
---

<div id="cart-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex justify-end transition-opacity duration-300">
  <div class="bg-[#0D121D] w-full max-w-md h-full border-l border-slate-800 flex flex-col justify-between p-6 overflow-y-auto relative shadow-2xl">
    <div>
      <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-6">
        <h3 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>🛒 Tu Pedido</span>
        </h3>
        <button onclick="closeCartModal()" class="text-slate-400 hover:text-white p-2 rounded-full hover:bg-slate-800 text-xl cursor-pointer" title="Cerrar">✕</button>
      </div>

      <!-- Mode Selector: En el local vs Para llevar -->
      <div class="bg-slate-900/90 p-1.5 rounded-xl border border-slate-800 grid grid-cols-2 gap-1 mb-6">
        <button id="order-mode-mesa" onclick="setOrderMode('mesa')" class="py-2 rounded-lg text-xs font-bold transition duration-200 bg-amber-500 text-slate-950 cursor-pointer">
          📍 Para Mesa en Mirador
        </button>
        <button id="order-mode-llevar" onclick="setOrderMode('llevar')" class="py-2 rounded-lg text-xs font-bold transition duration-200 text-slate-400 hover:text-white cursor-pointer">
          🛍️ Para Llevar / Recoger
        </button>
      </div>

      <!-- Order items container -->
      <div id="cart-items-list" class="space-y-4 mb-6">
        <!-- Render dinámico -->
      </div>
    </div>

    <div class="border-t border-slate-800 pt-6">
      <!-- Customer info inputs -->
      <div class="space-y-3 mb-6">
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Tu Nombre</label>
          <input type="text" id="order-name" placeholder="Ej: Carlos Páez" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-amber-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Mesa o Nota Especial</label>
          <input type="text" id="order-notes" placeholder="Ej: Mesa exterior / Sin azúcar" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-amber-500" />
        </div>
      </div>

      <!-- Subtotal calculation -->
      <div class="flex justify-between items-center mb-6 text-slate-300">
        <span class="text-sm font-semibold">Total a pagar:</span>
        <span id="cart-total-price" class="text-3xl font-black text-amber-400 font-serif">$0</span>
      </div>

      <!-- WhatsApp Submit Button -->
      <button onclick="sendOrderToWhatsApp()" class="w-full bg-[#25D366] hover:bg-green-500 text-white font-bold py-4 rounded-xl text-center shadow-lg shadow-green-500/20 flex items-center justify-center gap-2 text-base transition duration-300 cursor-pointer">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Enviar Pedido por WhatsApp</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  let cartItems = [];
  let orderMode = 'mesa';

  function addToCart(name, price, img) {
    const existing = cartItems.find(item => item.name === name);
    if (existing) {
      existing.qty += 1;
    } else {
      cartItems.push({ name, price, img, qty: 1 });
    }
    updateCartUI();
    if (typeof showToast === 'function') {
      showToast(`¡Agregado: ${name}!`);
    }
  }

  function removeFromCart(name) {
    cartItems = cartItems.filter(item => item.name !== name);
    updateCartUI();
    if (typeof showToast === 'function') {
      showToast('Producto eliminado del pedido');
    }
  }

  function changeQty(name, delta) {
    const item = cartItems.find(i => i.name === name);
    if (item) {
      item.qty += delta;
      if (item.qty <= 0) {
        removeFromCart(name);
      } else {
        updateCartUI();
      }
    }
  }

  function setOrderMode(mode) {
    orderMode = mode;
    const btnMesa = document.getElementById('order-mode-mesa');
    const btnLlevar = document.getElementById('order-mode-llevar');
    if (btnMesa && btnLlevar) {
      if (mode === 'mesa') {
        btnMesa.className = 'py-2 rounded-lg text-xs font-bold transition duration-200 bg-amber-500 text-slate-950 cursor-pointer';
        btnLlevar.className = 'py-2 rounded-lg text-xs font-bold transition duration-200 text-slate-400 hover:text-white cursor-pointer';
      } else {
        btnLlevar.className = 'py-2 rounded-lg text-xs font-bold transition duration-200 bg-amber-500 text-slate-950 cursor-pointer';
        btnMesa.className = 'py-2 rounded-lg text-xs font-bold transition duration-200 text-slate-400 hover:text-white cursor-pointer';
      }
    }
  }

  function updateCartUI() {
    const totalCount = cartItems.reduce((sum, item) => sum + item.qty, 0);
    const totalPrice = cartItems.reduce((sum, item) => sum + (item.price * item.qty), 0);
    
    const badge = document.getElementById('cart-badge');
    const totalEl = document.getElementById('cart-total-price');
    if (badge) badge.innerText = totalCount;
    if (totalEl) totalEl.innerText = '$' + totalPrice.toLocaleString('es-CO');

    const listContainer = document.getElementById('cart-items-list');
    if (!listContainer) return;

    if (cartItems.length === 0) {
      listContainer.innerHTML = `
        <div class="text-center py-12 text-slate-500">
          <span class="text-4xl block mb-2">🍹</span>
          <p class="text-sm font-medium">Tu pedido está vacío.</p>
          <p class="text-xs text-slate-600 mt-1">Explora nuestro menú y añade tus favoritos.</p>
        </div>
      `;
      return;
    }

    listContainer.innerHTML = cartItems.map(item => `
      <div class="bg-slate-900/90 p-3.5 rounded-2xl border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 group">
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <img src="${item.img}" class="w-14 h-14 rounded-xl object-cover border border-slate-800 flex-shrink-0" alt="${item.name}">
          <div class="min-w-0 flex-1">
            <h4 class="text-white font-bold text-sm leading-tight truncate">${item.name}</h4>
            <span class="text-amber-400 font-black text-xs block mt-0.5">$${(item.price * item.qty).toLocaleString('es-CO')}</span>
          </div>
        </div>
        <div class="flex items-center justify-between sm:justify-end gap-3 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-800/60">
          <div class="flex items-center border border-slate-800 bg-slate-950 rounded-xl px-2.5 py-1 gap-2">
            <button onclick="changeQty('${item.name}', -1)" class="text-slate-400 hover:text-white font-bold px-1 text-sm cursor-pointer" title="Disminuir">-</button>
            <span class="text-white font-bold text-xs min-w-[16px] text-center">${item.qty}</span>
            <button onclick="changeQty('${item.name}', 1)" class="text-slate-400 hover:text-white font-bold px-1 text-sm cursor-pointer" title="Aumentar">+</button>
          </div>
          <button onclick="removeFromCart('${item.name}')" class="text-xs font-semibold text-red-400 hover:text-white bg-red-500/10 hover:bg-red-600 border border-red-500/30 px-3 py-1.5 rounded-xl transition duration-200 flex items-center gap-1.5 shadow-sm cursor-pointer" title="Eliminar este producto">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            <span>Eliminar</span>
          </button>
        </div>
      </div>
    `).join('');
  }

  function openCartModal() {
    updateCartUI();
    const modal = document.getElementById('cart-modal');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeCartModal() {
    const modal = document.getElementById('cart-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  }

  function sendOrderToWhatsApp() {
    if (cartItems.length === 0) {
      alert('Añade al menos un producto a tu pedido.');
      return;
    }

    const nameInput = document.getElementById('order-name');
    const notesInput = document.getElementById('order-notes');
    const name = (nameInput && nameInput.value.trim()) || 'Cliente Mirador';
    const notes = (notesInput && notesInput.value.trim()) || 'Sin especificaciones';
    const totalPrice = cartItems.reduce((sum, item) => sum + (item.price * item.qty), 0);
    const modeText = orderMode === 'mesa' ? '📍 Para consumir en Mesa' : '🛍️ Para Llevar / Recoger';

    let itemsFormatted = cartItems.map(i => `• ${i.qty}x ${i.name} ($${(i.price * i.qty).toLocaleString('es-CO')})`).join('\n');

    let message = `*¡Hola El Mirador del Cielo!* 🌄\n\nQuisiera realizar el siguiente pedido:\n\n${itemsFormatted}\n\n*Modalidad:* ${modeText}\n*Total:* $${totalPrice.toLocaleString('es-CO')}\n*A nombre de:* ${name}\n*Nota/Mesa:* ${notes}\n\n¡Quedo atento a la confirmación!`;

    const encoded = encodeURIComponent(message);
    window.open(`https://wa.me/573000000000?text=${encoded}`, '_blank');
  }
</script>

