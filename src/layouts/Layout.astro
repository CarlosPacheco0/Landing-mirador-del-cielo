---
import '../styles/global.css';
import { url } from '../utils/paths';
import { reviews } from '../data/reviews';
import BottomNav from '../components/BottomNav.astro';
import ReviewModal from '../components/ReviewModal.astro';

interface BreadcrumbItem {
  name: string;
  item: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  breadcrumbs?: BreadcrumbItem[];
  additionalSchema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "El Mirador del Cielo | Gastronomía & Atardeceres en Río de Oro",
  description = "El Mirador del Cielo en Río de Oro, Cesar. Disfruta de la mejor vista panorámica, granizados artesanales, pizzetas crocantes y momentos inolvidables.",
  image = "/images/atardecer.png",
  breadcrumbs,
  additionalSchema
} = Astro.props;

const defaultSite = 'https://carlospacheco0.github.io';
const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : defaultSite;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || defaultSite).toString();
const ogImageURL = new URL(url(image), Astro.site || defaultSite).toString();
const menuURL = new URL(url('/menu'), Astro.site || defaultSite).toString();

// 1. Schema LocalBusiness & Restaurant de Google con datos completos
const restaurantSchema = {
  "@context": "https://schema.org",
  "@type": ["Restaurant", "TouristAttraction"],
  "@id": `${siteBase}/#restaurant`,
  "name": "El Mirador del Cielo",
  "alternateName": [
    "Mirador del Cielo",
    "El Mirador del Cielo Río de Oro",
    "Mirador Cerro del Monumento"
  ],
  "url": canonicalURL,
  "telephone": "+573000000000",
  "menu": menuURL,
  "hasMenu": menuURL,
  "acceptsReservations": "True",
  "servesCuisine": [
    "Colombiana",
    "Pizzetas Artesanales",
    "Granizados Frutales",
    "Cafetería",
    "Café de Origen",
    "Snacks y Comida Rápida",
    "Cócteles y Cervezas"
  ],
  "priceRange": "$$",
  "currenciesAccepted": "COP",
  "paymentAccepted": "Efectivo, Nequi, Daviplata, Bancolombia, Tarjeta de Crédito, Tarjeta de Débito, Transferencia",
  "image": [
    ogImageURL,
    new URL(url('/images/mirador.webp'), Astro.site || defaultSite).toString(),
    new URL(url('/images/monumento.png'), Astro.site || defaultSite).toString(),
    new URL(url('/images/atardecer.png'), Astro.site || defaultSite).toString(),
    new URL(url('/images/pizzeta.jpeg'), Astro.site || defaultSite).toString(),
    new URL(url('/images/granizados.jpeg'), Astro.site || defaultSite).toString()
  ],
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Cerro del Monumento a la Virgen del Rosario",
    "addressLocality": "Río de Oro",
    "addressRegion": "Cesar",
    "postalCode": "205010",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 8.2530,
    "longitude": -73.3855
  },
  "hasMap": "https://maps.google.com/maps?q=Cerro%20de%20la%20virgen%20del%20rosario%20rio%20de%20oro",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "16:00",
      "closes": "23:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "127",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": reviews.map(rev => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": rev.name
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": rev.rating.toString(),
      "bestRating": "5"
    },
    "reviewBody": rev.comment
  })),
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Pet Friendly", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Terraza al Aire Libre", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Vista Panorámica de Montaña y Atardecer", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Ambiente Familiar y Romántico", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Música Ambiental", "value": true }
  ]
};

// 2. Schema WebSite (Google Sitelinks)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteBase}/#website`,
  "name": "El Mirador del Cielo",
  "url": siteBase,
  "inLanguage": "es-CO"
};

// 3. Schema Breadcrumbs (Migas de Pan en Google)
const breadcrumbItems = breadcrumbs || [
  { name: "Inicio", item: siteBase }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((b, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": b.name,
    "item": b.item
  }))
};

const allSchemas = [
  restaurantSchema,
  websiteSchema,
  breadcrumbSchema,
  ...(additionalSchema ? (Array.isArray(additionalSchema) ? additionalSchema : [additionalSchema]) : [])
];
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="theme-color" content="#0B0F17" />
  <meta name="color-scheme" content="dark" />

  <!-- Metadatos de Geolocalización para SEO Local -->
  <meta name="geo.region" content="CO-CES" />
  <meta name="geo.placename" content="Río de Oro, Cesar" />
  <meta name="geo.position" content="8.2530;-73.3855" />
  <meta name="ICBM" content="8.2530, -73.3855" />

  <!-- Palabras clave locales estratégicas -->
  <meta name="keywords" content="El Mirador del Cielo, Rio de Oro Cesar, restaurante mirador, atardeceres Ocaña, turismo Cesar, pizzetas artesanales, granizados, mirador de la virgen, café de origen, gastronomía Río de Oro" />

  <!-- Open Graph (WhatsApp, Facebook, Instagram, LinkedIn) -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:site_name" content="El Mirador del Cielo" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content="Atardecer y vista panorámica en El Mirador del Cielo, Río de Oro" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X & Telegram Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Schema.org JSON-LD para SEO Local de Google -->
  {allSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  
  <!-- Preload Hero Image para carga instantánea (LCP) -->
  <link rel="preload" as="image" href={url('/images/mirador.webp')} fetchpriority="high" />
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- AOS CSS -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
</head>
<body class="pt-20 pb-20 md:pb-0">
  <slot />

  <!-- Modales Globales & Barra Inferior Móvil -->
  <ReviewModal />
  <BottomNav />

  <!-- AOS JS -->
  <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script is:inline>
    // Inicialización AOS
    if (typeof AOS !== 'undefined') {
      AOS.init({
        duration: 800,
        easing: 'ease-out-cubic',
        once: true,
        offset: 100,
      });
    }

    // Active Nav Link Highlighter on Scroll
    const sections = document.querySelectorAll('section, header');
    const navLinks = document.querySelectorAll('.nav-link');

    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop - 120;
        if (window.scrollY >= sectionTop) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });
  </script>
</body>
</html>

