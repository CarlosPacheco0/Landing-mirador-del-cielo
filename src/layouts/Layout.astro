---
import '../styles/global.css';
import { url } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "El Mirador del Cielo | Gastronomía & Atardeceres en Río de Oro",
  description = "El Mirador del Cielo en Río de Oro, Cesar. Disfruta de la mejor vista panorámica, granizados artesanales, pizzetas crocantes y momentos inolvidables.",
  image = "/images/atardecer.png"
} = Astro.props;

const defaultSite = 'https://carlospacheco0.github.io';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || defaultSite).toString();
const ogImageURL = new URL(url(image), Astro.site || defaultSite).toString();
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="theme-color" content="#0B0F17" />
  <meta name="color-scheme" content="dark" />

  <!-- Open Graph (WhatsApp, Facebook, Instagram, LinkedIn) -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:site_name" content="El Mirador del Cielo" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content="Atardecer y vista panorámica en El Mirador del Cielo, Río de Oro" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter / X & Telegram Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <!-- Schema.org JSON-LD para SEO Local y Google Maps -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": "El Mirador del Cielo",
    "image": ogImageURL,
    "description": description,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Cerro del Monumento a la Virgen",
      "addressLocality": "Río de Oro",
      "addressRegion": "Cesar",
      "addressCountry": "CO"
    },
    "servesCuisine": ["Colombiana", "Cafetería", "Pizzetas", "Granizados", "Cócteles"],
    "priceRange": "$$",
    "openingHours": [
      "Th-Su 16:00-23:00"
    ]
  })} />
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  
  <!-- Preload Hero Image para carga instantánea (LCP) -->
  <link rel="preload" as="image" href={url('/images/mirador.webp')} fetchpriority="high" />
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <!-- AOS CSS -->
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
</head>
<body class="pt-20">
  <slot />

  <!-- AOS JS -->
  <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script is:inline>
    // Inicialización AOS
    if (typeof AOS !== 'undefined') {
      AOS.init({
        duration: 800,
        easing: 'ease-out-cubic',
        once: true,
        offset: 100,
      });
    }

    // Active Nav Link Highlighter on Scroll
    const sections = document.querySelectorAll('section, header');
    const navLinks = document.querySelectorAll('.nav-link');

    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop - 120;
        if (window.scrollY >= sectionTop) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });
  </script>
</body>
</html>

